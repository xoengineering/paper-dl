{"created": "2017-09-05T09:10:06.483707+00:00", "modified": "2024-08-03T08:16:15.673144+00:00", "id": 884117, "conceptrecid": "884116", "doi": "10.5281/zenodo.884117", "conceptdoi": "10.5281/zenodo.884116", "doi_url": "https://doi.org/10.5281/zenodo.884117", "metadata": {"title": "The computer says 'DEBT': Towards a critical sociology of algorithms and algorithmic governance", "doi": "10.5281/zenodo.884117", "publication_date": "2017-09-04", "description": "<p>This paper uses Australia\u2019s automated processes to identify and recover social security over-payments as a case study to critically analyze the role of algorithms in government and public administration. The paper analyzes the algorithm in terms of: its performance with respect to its purpose; its role in public administration processes and principles; its impact on citizen-service users; and its role in politics. The paper concludes with a discussion of policy and public administrative principles that can be adopted for public sector governance and accountability with government by algorithm.\u00a0</p>", "access_right": "open", "creators": [{"name": "Henman, Paul", "affiliation": "University of Queensland"}], "keywords": ["algorithm", "welfare fraud", "social security", "Australia", "procedural justice"], "resource_type": {"title": "Preprint", "type": "publication", "subtype": "preprint"}, "meeting": {"title": "Data for Policy 2017: Government by Algorithm?", "acronym": "Data for Policy", "dates": "6-7 September 2017", "place": "London", "url": "http://dataforpolicy.org/"}, "license": {"id": "cc-by-4.0"}, "communities": [{"id": "dfp17"}], "relations": {"version": [{"index": 0, "is_last": true, "parent": {"pid_type": "recid", "pid_value": "884116"}}]}}, "title": "The computer says 'DEBT': Towards a critical sociology of algorithms and algorithmic governance", "links": {"self": "https://zenodo.org/api/records/884117", "self_html": "https://zenodo.org/records/884117", "preview_html": "https://zenodo.org/records/884117?preview=1", "doi": "https://doi.org/10.5281/zenodo.884117", "self_doi": "https://doi.org/10.5281/zenodo.884117", "self_doi_html": "https://zenodo.org/doi/10.5281/zenodo.884117", "reserve_doi": "https://zenodo.org/api/records/884117/draft/pids/doi", "parent": "https://zenodo.org/api/records/884116", "parent_html": "https://zenodo.org/records/884116", "parent_doi": "https://doi.org/10.5281/zenodo.884116", "parent_doi_html": "https://zenodo.org/doi/10.5281/zenodo.884116", "self_iiif_manifest": "https://zenodo.org/api/iiif/record:884117/manifest", "self_iiif_sequence": "https://zenodo.org/api/iiif/record:884117/sequence/default", "files": "https://zenodo.org/api/records/884117/files", "media_files": "https://zenodo.org/api/records/884117/media-files", "thumbnails": {"10": "https://zenodo.org/api/iiif/record:884117:Data_for_Policy_2017_paper_43.pdf/full/%5E10,/0/default.jpg", "50": "https://zenodo.org/api/iiif/record:884117:Data_for_Policy_2017_paper_43.pdf/full/%5E50,/0/default.jpg", "100": "https://zenodo.org/api/iiif/record:884117:Data_for_Policy_2017_paper_43.pdf/full/%5E100,/0/default.jpg", "250": "https://zenodo.org/api/iiif/record:884117:Data_for_Policy_2017_paper_43.pdf/full/%5E250,/0/default.jpg", "750": "https://zenodo.org/api/iiif/record:884117:Data_for_Policy_2017_paper_43.pdf/full/%5E750,/0/default.jpg", "1200": "https://zenodo.org/api/iiif/record:884117:Data_for_Policy_2017_paper_43.pdf/full/%5E1200,/0/default.jpg"}, "archive": "https://zenodo.org/api/records/884117/files-archive", "archive_media": "https://zenodo.org/api/records/884117/media-files-archive", "latest": "https://zenodo.org/api/records/884117/versions/latest", "latest_html": "https://zenodo.org/records/884117/latest", "versions": "https://zenodo.org/api/records/884117/versions", "draft": "https://zenodo.org/api/records/884117/draft", "access_links": "https://zenodo.org/api/records/884117/access/links", "access_grants": "https://zenodo.org/api/records/884117/access/grants", "access_